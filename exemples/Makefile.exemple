# Makefile pour un projet F++
# Usage:
#   make              → compile le programme principal (main.fpp → a.out)
#   make NOM=monfichier → compile monfichier.fpp → monfichier
#   make run          → compile et exécute
#   make clean        → supprime les binaires

FPPC     = python3 $(dir $(abspath $(lastword $(MAKEFILE_LIST))))../fppc.py
SOURCES  = $(wildcard *.fpp)
NOM     ?= a.out
SRC     ?= main.fpp

# Cible par défaut : compiler main.fpp
all: $(NOM)

$(NOM): $(SRC)
	$(FPPC) $(SRC) -o $(NOM)

# Compiler n'importe quel .fpp : make NOM=bonjour SRC=bonjour.fpp
%.out: %.fpp
	$(FPPC) $< -o $@

run: $(NOM)
	./$(NOM)

# Voir le C généré sans compiler
voir-c:
	$(FPPC) $(SRC) -S

clean:
	rm -f $(NOM) *.out *.c

.PHONY: all run voir-c clean
