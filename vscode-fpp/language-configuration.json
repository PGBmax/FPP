{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(\\balors|\\bfaire|\\bsinon)\\s*$",
    "decreaseIndentPattern": "^\\s*(fin|sinon|sinonsi)\\b"
  },
  "wordPattern": "[a-zA-Z_àâéèêëîïôùûüÀÂÉÈÊËÎÏÔÙÛÜ][a-zA-Z0-9_àâéèêëîïôùûüÀÂÉÈÊËÎÏÔÙÛÜ]*|\\d+\\.\\d+|\\d+"
}
